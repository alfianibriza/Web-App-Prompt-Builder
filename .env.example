# =================================================================
# SERVER-SIDE ENVIRONMENT VARIABLES (Vercel & Cloud Run / Local)
# =================================================================
# GEMINI_API_KEY: Required for AI smart requirements analysis and prompt polishing.
# On Vercel: Set in Project Settings -> Environment Variables.
# On Google AI Studio: Injected automatically via Secrets panel.
GEMINI_API_KEY=""

# APP_URL: Base URL of the application (e.g. https://your-project.vercel.app).
APP_URL=""

# =================================================================
# CLIENT-SIDE FIREBASE OVERRIDES (Optional for Vercel)
# =================================================================
# By default, Firebase reads from firebase-applet-config.json.
# If you prefer setting Firebase config in Vercel Environment Variables:
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_DATABASE_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""

